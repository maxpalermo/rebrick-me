# Opzionale: chiave API Rebrickable (https://rebrickable.com/users/me/settings/#api)
# Abilita le costruzioni alternative (MOC) e una mappatura più precisa di pezzi/colori.
REBRICKABLE_API_KEY=

# Nome mostrato per questo dispositivo durante la sincronizzazione
DEVICE_NAME=PC-casa

# Porta su cui esporre l'app
PORT=8080
